from collections.abc import Iterator
from typing import ClassVar

import numpy as np
from typing_extensions import Buffer

__version__: str

class ILogger:
    class Severity: ...

    INTERNAL_ERROR: ClassVar[ILogger.Severity]
    ERROR: ClassVar[ILogger.Severity]
    WARNING: ClassVar[ILogger.Severity]
    INFO: ClassVar[ILogger.Severity]
    VERBOSE: ClassVar[ILogger.Severity]
    def __init__(self) -> None: ...
    def log(self, severity: ILogger.Severity, msg: str) -> None: ...

class Logger(ILogger):
    def __init__(self, min_severity: ILogger.Severity = ...) -> None: ...

class DataType:
    FLOAT: ClassVar[DataType]
    HALF: ClassVar[DataType]
    INT32: ClassVar[DataType]
    INT64: ClassVar[DataType]

def nptype(trt_type: DataType) -> type[np.generic]: ...

class Dims:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> int: ...
    def __iter__(self) -> Iterator[int]: ...

class TensorIOMode:
    NONE: ClassVar[TensorIOMode]
    INPUT: ClassVar[TensorIOMode]
    OUTPUT: ClassVar[TensorIOMode]

class INetworkDefinition: ...

class ParserError:
    def desc(self) -> str: ...

class OnnxParser:
    @property
    def num_errors(self) -> int: ...
    def __init__(self, network: INetworkDefinition, logger: ILogger) -> None: ...
    def parse(self, model: Buffer, path: str | None = None) -> bool: ...
    def get_error(self, index: int) -> ParserError: ...

class MemoryPoolType:
    WORKSPACE: ClassVar[MemoryPoolType]

class BuilderFlag:
    FP16: ClassVar[BuilderFlag]
    TF32: ClassVar[BuilderFlag]

class IBuilderConfig:
    def set_memory_pool_limit(self, pool: MemoryPoolType, pool_size: int) -> None: ...
    def set_flag(self, flag: BuilderFlag) -> None: ...
    def clear_flag(self, flag: BuilderFlag) -> None: ...
    def get_flag(self, flag: BuilderFlag) -> bool: ...

class IHostMemory:
    @property
    def nbytes(self) -> int: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...

class Builder:
    def __init__(self, logger: ILogger) -> None: ...
    def create_network(self, flags: int = 0) -> INetworkDefinition: ...
    def create_builder_config(self) -> IBuilderConfig: ...
    def build_serialized_network(
        self, network: INetworkDefinition, config: IBuilderConfig
    ) -> IHostMemory | None: ...

class IExecutionContext:
    def set_tensor_address(self, name: str, memory: int) -> bool: ...
    def execute_async_v3(self, stream_handle: int) -> bool: ...

class ICudaEngine:
    @property
    def num_io_tensors(self) -> int: ...
    @property
    def device_memory_size_v2(self) -> int: ...
    def create_execution_context(self) -> IExecutionContext | None: ...
    def get_tensor_name(self, index: int) -> str: ...
    def get_tensor_mode(self, name: str) -> TensorIOMode: ...
    def get_tensor_shape(self, name: str) -> Dims: ...
    def get_tensor_dtype(self, name: str) -> DataType: ...

class Runtime:
    def __init__(self, logger: ILogger) -> None: ...
    def deserialize_cuda_engine(self, serialized_engine: Buffer) -> ICudaEngine | None: ...
